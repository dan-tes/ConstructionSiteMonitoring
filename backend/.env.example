# Copy to .env and adjust for your environment.

# Async SQLAlchemy URL — must use the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://csm:csm@localhost:5432/csm

# Secret used to derive stable salts for unknown usernames (so /auth/salt
# does not leak whether an account exists). Any long random string.
SECRET_KEY=change-me-to-a-long-random-string

# How long an issued session token stays valid.
SESSION_TTL_DAYS=7

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Regex for additionally-allowed origins. Default lets through any localhost port
# (Vite may fall back to 5174+). Set empty to allow only CORS_ORIGINS.
CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?

# --- File uploads & video analysis ---

# Directory for uploaded files (site plans, journal videos). Relative to the
# backend working dir unless absolute.
MEDIA_ROOT=media

# Base URL the browser can reach this API on. File URLs handed to the frontend
# are built as {PUBLIC_BASE_URL}/files/{id}.
PUBLIC_BASE_URL=http://localhost:8000

# Max size of a single uploaded file, in megabytes.
MAX_UPLOAD_MB=200

# Stubbed processing time for the video analysis pipeline (see analysis.py).
ANALYSIS_DELAY_SECONDS=8
